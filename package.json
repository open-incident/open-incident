{
  "name": "open-incident",
  "version": "0.0.2",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "db:generate": "pnpm --filter @openincident/db db:generate",
    "db:migrate": "pnpm --filter @openincident/db db:migrate",
    "db:rls": "pnpm --filter @openincident/db db:rls",
    "db:seed": "pnpm --filter @openincident/db db:seed",
    "db:seed:auth": "pnpm --filter @openincident/auth seed",
    "workspace:create": "pnpm --filter @openincident/db workspace:create",
    "workspace:purge": "pnpm --filter @openincident/db workspace:purge",
    "catalog:import": "pnpm --filter @openincident/catalog import"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0"
  }
}
