{
  "version": 1,
  "pack": "kubernetes",
  "title": "Kubernetes",
  "description": "Nodes, pods and containers from the Kubernetes pack — kubeletstats for what is running, k8s_cluster for what the API server thinks should be. Restarts and pending pods are the two that answer “is it the app or the cluster”.",
  "signals": [
    "k8s.pod.phase",
    "k8s.node.condition_ready"
  ],
  "panels": [
    {
      "id": "nodes-ready",
      "title": "Nodes ready",
      "query": "sum(k8s.node.condition_ready)",
      "type": "stat",
      "unit": "",
      "w": 4,
      "h": 120
    },
    {
      "id": "pods-running",
      "title": "Pods running",
      "query": "count(k8s.pod.phase == 2)",
      "type": "stat",
      "unit": "",
      "w": 4,
      "h": 120
    },
    {
      "id": "restarts",
      "title": "Container restarts",
      "query": "sum(k8s.container.restarts)",
      "type": "stat",
      "unit": "",
      "w": 4,
      "h": 120,
      "threshold": 1
    },
    {
      "id": "cpu-by-node",
      "title": "CPU used per node, cores",
      "query": "sum by (k8s.node.name) (k8s.node.cpu.usage)",
      "type": "line",
      "unit": "cores",
      "w": 6,
      "h": 160
    },
    {
      "id": "mem-by-node",
      "title": "Memory used per node",
      "query": "sum by (k8s.node.name) (k8s.node.memory.usage)",
      "type": "area",
      "unit": "B",
      "w": 6,
      "h": 160
    },
    {
      "id": "cpu-by-pod",
      "title": "CPU used per pod, cores",
      "query": "topk(8, sum by (k8s.pod.name) (k8s.pod.cpu.usage))",
      "type": "line",
      "unit": "cores",
      "w": 6,
      "h": 160
    },
    {
      "id": "mem-by-pod",
      "title": "Memory used per pod",
      "query": "topk(8, sum by (k8s.pod.name) (k8s.pod.memory.usage))",
      "type": "line",
      "unit": "B",
      "w": 6,
      "h": 160
    },
    {
      "id": "restarts-by-pod",
      "title": "Restarts per pod",
      "query": "topk(8, max by (k8s.pod.name) (k8s.container.restarts))",
      "type": "line",
      "unit": "",
      "w": 6,
      "h": 160,
      "threshold": 1
    },
    {
      "id": "pods-by-namespace",
      "title": "Pods per namespace",
      "query": "count by (k8s.namespace.name) (k8s.pod.phase)",
      "type": "line",
      "unit": "",
      "w": 6,
      "h": 160
    },
    {
      "id": "net-by-pod",
      "title": "Pod network, bytes per second",
      "query": "topk(8, sum by (k8s.pod.name) (rate(k8s.pod.network.io[5m])))",
      "type": "area",
      "unit": "B/s",
      "w": 12,
      "h": 160
    }
  ]
}
