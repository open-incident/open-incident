# ------------------------------------------------------------------------
# Self-hosting in production: compose.yaml (repository root) builds and starts
# postgres + redis + web + worker + migrations. Three commands:
#   git clone … && cd open-incident
#   cp .env.example .env   # set BETTER_AUTH_SECRET, ENCRYPTION_KEY, APP_DB_PASSWORD,
#                          # and your domains in BASE_DOMAIN / STATUS_BASE_DOMAIN
#   docker compose up -d   # http://localhost:3000
# The internal hosts (postgres, redis) are pinned by compose.yaml and take
# precedence over the development values below.
# ------------------------------------------------------------------------

# Skylark Systems demo workspace, installed on the first start of the
# production compose stack (login amelie@skylark.dev / demo-openincident).
# Switch to false once your own workspace exists.
SEED_DEMO=true

# Runtime edition: self-hosted (default) or cloud. Self-hosted unlocks the
# whole AGPL core; the /ee features stay locked. With "cloud", entitlements are
# resolved by an external control plane instead. Read server-side only.
# OPENINCIDENT_EDITION=self-hosted
# Enterprise capabilities on a standalone install (ee/, commercially licensed —
# free for development and testing). Comma-separated: sso, customRoles,
# auditLogAdvanced, customerStatusPages. Unset: the screens say "unavailable".
# OI_ENTITLEMENTS=sso,customRoles
# Single sign-on against an identity provider on a private address (an internal
# Keycloak, a test double): the SSO plugin refuses non-public hosts unless their
# origin is listed here. Comma-separated origins.
# SSO_TRUSTED_IDP_ORIGINS=http://keycloak.internal:8080

# Database — TWO roles, on purpose.
# The application connects as `openincident_app`, a role that does not own the
# tables: that is what makes row-level security effective (an owner bypasses
# it). Migrations, `db:rls` and the seeds connect as the owner.
# docker/docker-compose.yml provides these defaults; host ports are shifted —
# 5441/6381 — so the stack can coexist with other local projects.
DATABASE_URL=postgres://openincident_app:openincident_app@localhost:5441/openincident
DATABASE_ADMIN_URL=postgres://openincident:openincident@localhost:5441/openincident
# Password `db:rls` gives the application role when it creates it.
APP_DB_PASSWORD=openincident_app

# Redis — BullMQ queues (mail outbox, housekeeping; escalations later)
REDIS_URL=redis://localhost:6381

# Multi-tenant resolution: {slug}.$BASE_DOMAIN → workspace "slug". Every link
# the product writes (emails, callbacks, status pages) is built from it.
# Unset: the development server uses localhost:3100 (skylark.localhost:3100
# works in modern browsers) and the compose stack uses localhost:3000. Set your
# real domain here in production.
# BASE_DOMAIN=acme.example
# Single-workspace self-hosting: the workspace served on the bare domain.
DEFAULT_TENANT_SLUG=skylark

# Auth (Better Auth)
BETTER_AUTH_SECRET=change-me
# Control-plane deployments: session cookie shared between www. and the
# workspace subdomains.
# AUTH_COOKIE_DOMAIN=
# Sign-in is refused until the address is confirmed. Implies the mail below.
# REQUIRE_EMAIL_VERIFICATION=false
# Send the confirmation mail WITHOUT gating sign-in on it. Use one or the other.
# SEND_EMAIL_VERIFICATION=false
# Named in that mail, and enforced by whoever runs the deadline.
# EMAIL_VERIFICATION_DEADLINE_DAYS=7
# Social sign-in — each pair switches its provider on.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Encryption of secrets at rest (integration tokens, provider keys).
# 32 random bytes: openssl rand -base64 32
ENCRYPTION_KEY=change-me-32-bytes-minimum-please

# Control-plane deployments: the "workspace not found" 404 points here so a
# visitor can create one.
# SIGNUP_URL=
# Control-plane deployments (OPENINCIDENT_EDITION=cloud): Settings →
# Subscription & invoices asks the control plane's gateway for the offers, the
# workspace's subscription, its invoices and the payment sessions — the product
# carries no price and no provider key. Same secret on both sides. Unset, the
# screen says the instance has no control plane.
# CLOUD_GATEWAY_URL=http://console:3001
# CLOUD_GATEWAY_SECRET=

# Email — sending. Instance-wide transport: SMTP (covers every relay) or one
# of the native APIs (the first one filled in wins). Without any of them the
# emails are written to the server logs.
MAIL_FROM=no-reply@open-incident.local
SMTP_HOST=localhost
SMTP_PORT=1027
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# RESEND_API_KEY=
# BREVO_API_KEY=
# MAILJET_API_KEY=
# MAILJET_API_SECRET=

# --- On-call notifications ------------------------------------------------
# Email always works (it reuses the SMTP transport above). The channels that
# wake people up need a provider; a channel without one is shown as
# unavailable on the instance — never silently skipped.
# Web push (VAPID). Generate a pair with: pnpm --filter @openincident/oncall exec tsx src/vapid.ts
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_SUBJECT=mailto:ops@example.com
# SMS and voice through Twilio (E.164 sender). Voice acknowledges with DTMF "4".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Slack app (milestone 3) ------------------------------------------------
# Create a Slack app with a slash command /incident, interactivity and events
# pointing at /api/slack/commands, /api/slack/interactions, /api/slack/events,
# and the OAuth redirect /api/slack/oauth/callback. Without these the Slack
# card in Settings → Integrations says the instance is not configured.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Optional: fixed OAuth redirect (cloud, one callback host for every workspace).
SLACK_REDIRECT_URI=
# Tests only: point the Slack Web API at a mock (e.g. http://127.0.0.1:3197).
SLACK_API_BASE=

# --- Status pages (milestone 4) --------------------------------------------
# The public pages are served by apps/status, a separate app that only reads
# snapshots. Pages answer on {slug}.$STATUS_BASE_DOMAIN and on their verified
# custom domain (CNAME → status.$BASE_DOMAIN, TLS by the reverse proxy).
# Unset: status.localhost:3107 in development, status.localhost:3001 in the
# compose stack. In production, the domain your proxy sends to the status app.
# STATUS_BASE_DOMAIN=status.acme.example
# Single-page self-hosting: the page served on the bare STATUS_BASE_DOMAIN.
STATUS_DEFAULT_PAGE=
# Customers' custom domains get their certificate on demand: the proxy asks
# GET /api/tls?domain=… whether we serve that hostname. Set a key here and in
# the proxy's ask URL when that endpoint is reachable from outside.
# STATUS_TLS_ASK_KEY=

# --- AI (milestone 5) ------------------------------------------------------
# Any OpenAI-compatible endpoint: Mistral La Plateforme (EU), an EU-region
# deployment, or a self-hosted Ollama/vLLM. Without AI_API_BASE and AI_MODEL
# every assistant feature is shown as unavailable on the instance — nothing is
# faked. Prompts are redacted (emails, phones, IPs, hostnames, secrets) before
# they leave.
AI_API_BASE=
AI_API_KEY=
AI_MODEL=
AI_EMBED_MODEL=
AI_PROVIDER_LABEL=

# --- Object storage (workspace files: logos) --------------------------------
# Any S3-compatible bucket. All five S3_* variables or none: a partial set
# stops the app at startup; none means the upload is shown as unavailable.
# With the bundled MinIO (`docker compose --profile storage up -d`):
#   S3_ENDPOINT=http://minio:9000  S3_REGION=us-east-1  S3_BUCKET=openincident
#   S3_ACCESS_KEY_ID=openincident  S3_SECRET_ACCESS_KEY=<a real secret>
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- Issue trackers ----------------------------------------------------------
# Credentials are entered per workspace in Settings → Integrations and stored
# encrypted. These overrides exist for tests and proxies; leave them empty to
# reach the vendors directly.
GITHUB_API_BASE=
GITLAB_API_BASE=
# Documentation tools (post-mortem export) — same idea, per-workspace credentials.
CONFLUENCE_API_BASE=
NOTION_API_BASE=
JIRA_API_BASE=
LINEAR_API_BASE=

# --- Microsoft Teams --------------------------------------------------------
# One Azure bot registration per instance (App registration: bot + Graph
# application permissions Channel.Create, Channel.ReadBasic.All, User.Read.All).
# Messaging endpoint: https://<workspace>.<BASE_DOMAIN>/api/teams/messages —
# any workspace host works; the team pairs itself with a code from the settings.
# Without TEAMS_APP_ID/SECRET the Teams card says the instance has no bot.
TEAMS_APP_ID=
TEAMS_APP_SECRET=
# Overrides for tests and proxies; leave empty for Microsoft's hosts.
TEAMS_LOGIN_BASE=
TEAMS_GRAPH_BASE=
TEAMS_OPENID_CONFIG=
TEAMS_SERVICE_URL_OVERRIDE=

# Where the worker reaches the web app to post heartbeat alerts to the
# workspace's own ingest endpoint. Empty: the workspace's public origin.
# In the compose stack: http://web:3000
INTERNAL_WEB_ORIGIN=

# --- QA from the admin (Settings → QA) --------------------------------------
# The worker runs the repository's test suites (Playwright smoke, vitest, tsc,
# eslint, prettier) from its source checkout. Only where the worker runs from
# one, with Chrome and Mailpit on the same machine. These tell the smoke suite
# where the product and Mailpit answer; unset, BASE_DOMAIN, STATUS_BASE_DOMAIN
# and http://localhost:8027 are used.
# QA_WEB_HOST=localhost:3100
# QA_STATUS_HOST=status.localhost:3107
# QA_MAILPIT_URL=http://localhost:8027
