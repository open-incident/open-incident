  <key>CFBundleDisplayName</key><string>OI RUM Demo</string>
  <key>CFBundleIdentifier</key><string>dev.openincident.rumdemo</string>
  <key>CFBundleExecutable</key><string>OIRumDemo</string>
  <key>CFBundlePackageType</key><string>APPL</string>
